<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CuaHangNoiThat.Controls.AppSwitch"
             x:Name="Root" WidthRequest="58" HeightRequest="44">
    <Grid>
        <Border WidthRequest="52" HeightRequest="30" StrokeThickness="0" StrokeShape="RoundRectangle 15"
                BackgroundColor="{StaticResource BorderSubtle}" HorizontalOptions="Center" VerticalOptions="Center" Padding="4">
            <Border.Triggers>
                <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference Root}, Path=IsToggled}" Value="True">
                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                </DataTrigger>
            </Border.Triggers>
            <Ellipse WidthRequest="22" HeightRequest="22" Fill="{StaticResource White}" HorizontalOptions="Start" VerticalOptions="Center">
                <Ellipse.Triggers>
                    <DataTrigger TargetType="Ellipse" Binding="{Binding Source={x:Reference Root}, Path=IsToggled}" Value="True">
                        <Setter Property="HorizontalOptions" Value="End" />
                    </DataTrigger>
                </Ellipse.Triggers>
            </Ellipse>
        </Border>
        <Button BackgroundColor="Transparent" BorderWidth="0" Padding="0" Clicked="OnToggleClicked"
                SemanticProperties.Description="{Binding Source={x:Reference Root}, Path=AccessibleName}" />
    </Grid>
</ContentView>
