<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CuaHangNoiThat.Controls.ProductImageView"
             BackgroundColor="{StaticResource SurfaceMuted}" HeightRequest="150">
    <Grid>
        <VerticalStackLayout x:Name="Fallback" Spacing="6" HorizontalOptions="Center" VerticalOptions="Center" Padding="8">
            <Image Source="category_livingroom.svg" HeightRequest="48" WidthRequest="48" Opacity="0.5" AutomationProperties.IsInAccessibleTree="False" />
            <Label Text="Ảnh chưa có sẵn" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
        <Image x:Name="Photo" Aspect="AspectFit" />
        <ActivityIndicator x:Name="Loading" Color="{StaticResource Primary}" IsVisible="False"
                           WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="Center" />
    </Grid>
</ContentView>
