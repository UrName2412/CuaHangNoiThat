<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CuaHangNoiThat.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controllers="clr-namespace:CuaHangNoiThat.Controllers"
    Shell.FlyoutBehavior="Disabled"
    Shell.TabBarBackgroundColor="#FFFFFF"
    Shell.TabBarForegroundColor="#A34D16"
    Shell.TabBarUnselectedColor="#77716B"
    Shell.TabBarTitleColor="#A34D16">

    <TabBar>
        <Tab Title="Trang chủ" Icon="nav_home.svg" AutomationId="HomeTab">
            <ShellContent ContentTemplate="{DataTemplate controllers:HomeController}" Route="HomePage" />
        </Tab>
        <Tab Title="Danh mục" Icon="nav_catalog.svg" AutomationId="CatalogTab">
            <ShellContent ContentTemplate="{DataTemplate controllers:CatalogController}" Route="CatalogPage" />
        </Tab>
        <Tab Title="Phòng AR" Icon="nav_room.svg" AutomationId="RoomTab">
            <ShellContent ContentTemplate="{DataTemplate controllers:RoomStagerController}" Route="RoomStagerPage" />
        </Tab>
        <Tab Title="Giỏ hàng" Icon="nav_cart.svg" AutomationId="CartTab">
            <ShellContent ContentTemplate="{DataTemplate controllers:CartController}" Route="CartPage" />
        </Tab>
        <Tab Title="Đơn hàng" Icon="nav_orders.svg" AutomationId="OrdersTab">
            <ShellContent ContentTemplate="{DataTemplate controllers:OrdersController}" Route="OrdersPage" />
        </Tab>
    </TabBar>
</Shell>