<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CuaHangNoiThat.Models"
             xmlns:controllers="clr-namespace:CuaHangNoiThat.Controllers"
             x:Class="CuaHangNoiThat.Views.PromotionPage"
             x:DataType="controllers:PromotionController"
             x:Name="PageRoot"
             Title="Khuyến mãi"
             BackgroundColor="{StaticResource PageBackground}">
    <ScrollView>
        <VerticalStackLayout Padding="20,18,20,30" Spacing="20">
            <VerticalStackLayout Spacing="4">
                <Label Text="MOKHA LIVING" Style="{StaticResource Eyebrow}" />
                <Label Text="Ưu đãi của bạn" Style="{StaticResource PageTitle}" />
                <Label Text="Các chương trình và mã giảm giá hiện có." Style="{StaticResource BodyText}" TextColor="{StaticResource TextSecondary}" />
            </VerticalStackLayout>

            <Border IsVisible="{Binding IsBusy}" Padding="12" BackgroundColor="{StaticResource SurfaceMuted}" StrokeThickness="0" StrokeShape="RoundRectangle 12">
                <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource Primary}" WidthRequest="20" HeightRequest="20" />
                    <Label Text="Đang tải ưu đãi..." Style="{StaticResource Caption}" VerticalTextAlignment="Center" />
                </HorizontalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="10">
                <Label Text="Chương trình khuyến mãi" Style="{StaticResource SectionTitle}" />
                <VerticalStackLayout IsVisible="{Binding HasPromotions}" BindableLayout.ItemsSource="{Binding Promotions}" Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:PromotionDto">
                            <Border Style="{StaticResource Card}" Padding="16">
                                <VerticalStackLayout Spacing="7">
                                    <Label Text="{Binding TenCtkM}" Style="{StaticResource CardTitle}" FontSize="17" />
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <Label Text="{Binding NgayBd, StringFormat='Bắt đầu: {0:dd/MM/yyyy}'}" Style="{StaticResource Caption}" />
                                        <Label Grid.Column="1" Text="{Binding NgayKt, StringFormat='Kết thúc: {0:dd/MM/yyyy}'}" Style="{StaticResource Caption}" HorizontalTextAlignment="End" />
                                    </Grid>
                                    <Label Text="{Binding GhiChu}" Style="{StaticResource BodyText}" TextColor="{StaticResource TextSecondary}" LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Border IsVisible="{Binding HasNoPromotions}" Style="{StaticResource Card}" Padding="16">
                    <Label Text="Hiện chưa có chương trình khuyến mãi." Style="{StaticResource BodyText}" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="10">
                <Label Text="Voucher" Style="{StaticResource SectionTitle}" />
                <VerticalStackLayout IsVisible="{Binding HasVouchers}" BindableLayout.ItemsSource="{Binding Vouchers}" Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:VoucherDto">
                            <Border Style="{StaticResource Card}" Padding="14">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                                        <Label Text="{Binding IdVoucher}" Style="{StaticResource CardTitle}" />
                                        <Label Text="{Binding PhanTram, StringFormat='Giảm {0}%'}" Style="{StaticResource BodyText}" TextColor="{StaticResource Primary}" />
                                        <Label Text="{Binding SoLuong, StringFormat='Số lượng còn: {0}'}" Style="{StaticResource Caption}" />
                                    </VerticalStackLayout>
                                    <Button Grid.Column="1"
                                            Text="Sao chép"
                                            Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.CopyVoucherCommand}"
                                            CommandParameter="{Binding .}"
                                            Style="{StaticResource SecondaryButton}"
                                            FontSize="12"
                                            Padding="12,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Border IsVisible="{Binding HasNoVouchers}" Style="{StaticResource Card}" Padding="16">
                    <Label Text="Hiện chưa có voucher khả dụng." Style="{StaticResource BodyText}" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
                </Border>
            </VerticalStackLayout>

            <Border IsVisible="{Binding HasError}" Padding="14" BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource BorderSubtle}" StrokeShape="RoundRectangle 12">
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource BodyText}" TextColor="{StaticResource Danger}" HorizontalTextAlignment="Center" />
            </Border>
            <Label Text="{Binding Message}" Style="{StaticResource BodyText}" TextColor="{StaticResource Success}" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
