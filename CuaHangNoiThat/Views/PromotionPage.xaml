<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CuaHangNoiThat.Models"
             xmlns:controllers="clr-namespace:CuaHangNoiThat.Controllers"
             x:Class="CuaHangNoiThat.Views.PromotionPage"
             x:DataType="controllers:PromotionController"
             x:Name="PageRoot"
             Title="Khuyến mãi"
             BackgroundColor="#FAFAF9">
    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="12,12,12,24" Spacing="14">
                <Label Text="Chương trình khuyến mãi" FontSize="16" FontAttributes="Bold" TextColor="#241A15"/>
                <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" Color="#A34D16"/>

                <VerticalStackLayout IsVisible="{Binding HasPromotions}" BindableLayout.ItemsSource="{Binding Promotions}" Spacing="4">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:PromotionDto">
                            <Border BackgroundColor="White" Stroke="#ECE8E3" StrokeShape="RoundRectangle 14" Padding="14" Margin="0,4">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="{Binding TenCtkM}" FontSize="13" FontAttributes="Bold" TextColor="#191817"/>
                                    <Label Text="{Binding NgayBd, StringFormat='Thời gian: {0:dd/MM/yyyy}'}" FontSize="10" TextColor="#8A8580"/>
                                    <Label Text="{Binding NgayKt, StringFormat='đến {0:dd/MM/yyyy}'}" FontSize="10" TextColor="#8A8580"/>
                                    <Label Text="{Binding GhiChu}" FontSize="9" TextColor="#77716B" MaxLines="2" LineBreakMode="TailTruncation"/>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Label Text="Hiện chưa có chương trình khuyến mãi." IsVisible="{Binding HasNoPromotions}" FontSize="12" TextColor="#8A8580" HorizontalOptions="Center"/>

                <Label Text="Voucher của tôi" FontSize="16" FontAttributes="Bold" TextColor="#241A15" Margin="0,10,0,0"/>
                <VerticalStackLayout IsVisible="{Binding HasVouchers}" BindableLayout.ItemsSource="{Binding Vouchers}" Spacing="4">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:VoucherDto">
                            <Border BackgroundColor="White" Stroke="#ECE8E3" StrokeShape="RoundRectangle 14" Padding="14" Margin="0,4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Column="0">
                                        <Label Text="{Binding IdVoucher}" FontSize="12" FontAttributes="Bold" TextColor="#191817"/>
                                        <Label Text="{Binding PhanTram, StringFormat='Giảm {0}%'}" FontSize="10" TextColor="#A34D16"/>
                                        <Label Text="{Binding SoLuong, StringFormat='Còn lại: {0}'}" FontSize="9" TextColor="#8A8580"/>
                                    </VerticalStackLayout>
                                    <Button Grid.Column="1" Text="Sao chép" Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.CopyVoucherCommand}" CommandParameter="{Binding}" FontSize="9" TextColor="#A34D16" BackgroundColor="#F5F3F0" Padding="10,4" HeightRequest="44"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Label Text="Hiện chưa có voucher khả dụng." IsVisible="{Binding HasNoVouchers}" FontSize="12" TextColor="#8A8580" HorizontalOptions="Center"/>
                <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="#A34D16" FontSize="11" HorizontalTextAlignment="Center"/>
                <Label Text="{Binding Message}" TextColor="#A34D16" FontSize="11" HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>