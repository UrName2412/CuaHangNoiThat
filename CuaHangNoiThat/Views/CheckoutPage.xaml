<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CuaHangNoiThat.Models"
             xmlns:controllers="clr-namespace:CuaHangNoiThat.Controllers"
             x:Class="CuaHangNoiThat.Views.CheckoutPage"
             x:DataType="controllers:CheckoutController"
             x:Name="PageRoot"
             Title="Thanh toán"
             BackgroundColor="{StaticResource PageBackground}">
    <Grid RowDefinitions="*,Auto">
    <ScrollView IsVisible="{Binding IsCheckoutVisible}">
            <VerticalStackLayout Padding="20,18,20,24" Spacing="20">
                <VerticalStackLayout Spacing="4">
                    <Label Text="MOKHA LIVING" Style="{StaticResource Eyebrow}" />
                    <Label Text="Kiểm tra thông tin trước khi hoàn tất đơn hàng." Style="{StaticResource BodyText}" TextColor="{StaticResource TextSecondary}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Thông tin liên hệ" Style="{StaticResource SectionTitle}" VerticalTextAlignment="Center" />
                        <Button Grid.Column="1" Text="Sửa hồ sơ" Command="{Binding OpenProfileCommand}" Style="{StaticResource SecondaryButton}" FontSize="12" Padding="14,0" />
                    </Grid>
                    <Label Text="Lấy từ hồ sơ. Xác nhận đơn hàng không đổi tài khoản." Style="{StaticResource Caption}" />
                    <Border Style="{StaticResource Card}" Padding="14">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding FullName}" Style="{StaticResource BodyText}" />
                            <Label Text="{Binding Email}" Style="{StaticResource Caption}" />
                            <Label Text="{Binding Phone}" Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10">
                    <Label Text="Địa chỉ giao hàng" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource Card}" Padding="14,4">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" MinimumHeightRequest="52">
                            <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                                <Label Text="Giao đến" Style="{StaticResource Eyebrow}" />
                                <Label Text="{Binding SelectedAddressText}" Style="{StaticResource BodyText}" MaxLines="2" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="›" Style="{StaticResource BodyText}" FontSize="24" TextColor="{StaticResource Primary}" VerticalTextAlignment="Center" />
                            <Button Grid.ColumnSpan="2" Command="{Binding OpenAddressPickerCommand}" IsEnabled="{Binding IsNotBusy}"
                                    BackgroundColor="Transparent" BorderWidth="0" SemanticProperties.Description="{Binding SelectedAddressText}"
                                    SemanticProperties.Hint="Mở danh sách địa chỉ giao hàng" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <Border Style="{StaticResource Card}" Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Sản phẩm đã chọn" Style="{StaticResource SectionTitle}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding CheckoutItems}" Spacing="12">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:CartItemModel">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12">
                                        <Label Text="{Binding ProductName}" Style="{StaticResource CardTitle}" />
                                        <Label Grid.Column="1" Text="{Binding Quantity, StringFormat='x{0}'}" />
                                        <Label Grid.Row="1" Text="{Binding UnitPriceFormatted}" Style="{StaticResource Caption}" />
                                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding TotalPriceFormatted}" TextColor="{StaticResource Primary}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <BoxView HeightRequest="1" Color="{StaticResource BorderSubtle}" />
                        <Label Text="Giao hàng tiêu chuẩn" Style="{StaticResource CardTitle}" />
                        <Label Text="MOKHA sẽ liên hệ xác nhận thời gian giao và lắp đặt." Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                </Border>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Voucher" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource Card}" Padding="14,4">
                        <Grid ColumnDefinitions="*,Auto" HeightRequest="48">
                            <Label Text="{Binding VoucherPickerText}" Style="{StaticResource BodyText}" VerticalTextAlignment="Center" />
                            <Label Grid.Column="1" Text="›" Style="{StaticResource BodyText}" FontSize="24" TextColor="{StaticResource Primary}" VerticalTextAlignment="Center" />
                            <Button Grid.ColumnSpan="2" Command="{Binding OpenVoucherPickerCommand}" IsEnabled="{Binding IsNotBusy}"
                                    BackgroundColor="Transparent" BorderWidth="0" SemanticProperties.Description="{Binding VoucherPickerText}"
                                    SemanticProperties.Hint="Mở danh sách voucher có sẵn" />
                        </Grid>
                    </Border>
                    <Border IsVisible="{Binding HasAppliedVoucher}" Style="{StaticResource Card}" Padding="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding VoucherCode, StringFormat='Đang dùng: {0}'}" Style="{StaticResource CardTitle}" />
                                <Label Text="{Binding VoucherDiscount, StringFormat='Tiết kiệm {0:N0} đ'}" Style="{StaticResource Caption}" TextColor="{StaticResource Success}" />
                                <Label Text="{Binding SelectedVoucher.Promotion.NgayKt, StringFormat='Hạn dùng: {0:dd/MM/yyyy}'}" Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Bỏ chọn" Command="{Binding RemoveVoucherCommand}" IsEnabled="{Binding IsNotBusy}" Style="{StaticResource SecondaryButton}" FontSize="12" Padding="12,0" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <Border Style="{StaticResource Card}" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Phương thức thanh toán" Style="{StaticResource SectionTitle}" />
                        <Border BackgroundColor="{StaticResource Secondary}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="14,12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="Thanh toán khi nhận hàng" Style="{StaticResource CardTitle}" />
                                    <Label Text="COD · Thanh toán khi đơn hàng được giao" Style="{StaticResource Caption}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="✓" TextColor="{StaticResource Primary}" FontSize="20" VerticalTextAlignment="Center" />
                            </Grid>
                        </Border>
                        <Label Text="{Binding PaymentDescription}" Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                </Border>

                <Border IsVisible="{Binding IsBusy}"
                        Padding="12"
                        BackgroundColor="{StaticResource SurfaceMuted}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12">
                    <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                        <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource Primary}" WidthRequest="20" HeightRequest="20" />
                        <Label Text="Đang xử lý..." Style="{StaticResource Caption}" VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>
                </Border>
                <Label Text="{Binding Message}" Style="{StaticResource BodyText}" TextColor="{StaticResource Primary}" HorizontalTextAlignment="Center" />
                <Button Text="Tải lại thông tin thanh toán" IsVisible="{Binding CanRetryOrder}" Command="{Binding RefreshOrderCommand}" Style="{StaticResource SecondaryButton}" />
                <Border BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource BorderSubtle}" StrokeShape="RoundRectangle 16" Padding="16" Margin="0,0,0,4">
            <VerticalStackLayout Spacing="10">
                <Label Text="Tóm tắt thanh toán" Style="{StaticResource SectionTitle}" />
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                    <Label Text="Tiền hàng" Style="{StaticResource Caption}" />
                    <Label Grid.Column="1" Text="{Binding SubtotalAmount, StringFormat='{0:N0} đ'}" Style="{StaticResource BodyText}" />
                    <Label Grid.Row="1" Text="Phí giao hàng" Style="{StaticResource Caption}" />
                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding ShippingAmount, StringFormat='{0:N0} đ'}" Style="{StaticResource BodyText}" />
                    <Label Grid.Row="2" Text="Giảm giá" Style="{StaticResource Caption}" />
                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding VoucherDiscount, StringFormat='- {0:N0} đ'}" Style="{StaticResource BodyText}" TextColor="{StaticResource Success}" />
                </Grid>
                <BoxView HeightRequest="1" Color="{StaticResource BorderSubtle}" />
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Tổng thanh toán" FontFamily="OpenSansSemibold" FontSize="15" />
                    <Label Grid.Column="1" Text="{Binding TotalAmount, StringFormat='{0:N0} đ'}" FontFamily="OpenSansSemibold" FontSize="17" TextColor="{StaticResource Primary}" />
                </Grid>

            </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
    </ScrollView>
    <Border Grid.Row="1" IsVisible="{Binding IsCheckoutVisible}" BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource BorderSubtle}" Padding="16,12">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <VerticalStackLayout VerticalOptions="Center">
                <Label Text="Tổng thanh toán" Style="{StaticResource Caption}" />
                <Label Text="{Binding TotalAmount, StringFormat='{0:N0} đ'}" TextColor="{StaticResource Primary}" FontSize="20" FontFamily="OpenSansSemibold" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="{Binding PlaceOrderText}" Command="{Binding ConfirmCheckoutCommand}" IsEnabled="{Binding CanPlaceOrder}" Style="{StaticResource PrimaryButton}" Padding="24,0" />
        </Grid>
    </Border>
    <ScrollView Grid.RowSpan="2" IsVisible="{Binding IsOrderCompleted}">
        <VerticalStackLayout Padding="28,48" Spacing="20" VerticalOptions="Center">
            <Label Text="Đặt hàng thành công" Style="{StaticResource PageTitle}" HorizontalTextAlignment="Center" TextColor="{StaticResource Success}" />
            <Label Text="{Binding CompletedOrderId, StringFormat='Mã đơn hàng: #{0}'}" HorizontalTextAlignment="Center" />
            <Label Text="{Binding Message}" Style="{StaticResource BodyText}" HorizontalTextAlignment="Center" />
            <Button Text="Xem đơn mua" Command="{Binding ViewOrdersCommand}" Style="{StaticResource PrimaryButton}" />
            <Button Text="Tiếp tục mua sắm" Command="{Binding ContinueShoppingCommand}" Style="{StaticResource SecondaryButton}" />
        </VerticalStackLayout>
    </ScrollView>
    <Grid Grid.RowSpan="2" IsVisible="{Binding IsAddressPickerOpen}" BackgroundColor="#80000000" VerticalOptions="Fill" HorizontalOptions="Fill">
        <Border BackgroundColor="{StaticResource PageBackground}" StrokeThickness="0" StrokeShape="RoundRectangle 22,22,0,0" VerticalOptions="End" Padding="20,18,20,24">
            <VerticalStackLayout Spacing="14">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                        <Label Text="Chọn địa chỉ giao hàng" Style="{StaticResource SectionTitle}" />
                        <Label Text="Chọn nơi nhận hàng cho đơn này." Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="Đóng" Command="{Binding CloseAddressPickerCommand}" IsEnabled="{Binding IsNotBusy}" Style="{StaticResource SecondaryButton}" FontSize="12" Padding="12,0" />
                </Grid>
                <CollectionView ItemsSource="{Binding Addresses}" IsVisible="{Binding HasAddresses}" SelectionMode="None" HeightRequest="300">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:AddressDto">
                            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,8">
                                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="8" RowSpacing="8">
                                    <Label Text="{Binding DisplayAddress}" Style="{StaticResource BodyText}" />
                                    <Label Grid.Column="1" Text="Mặc định" IsVisible="{Binding IsDefault}" Style="{StaticResource Eyebrow}" VerticalTextAlignment="Center" />
                                    <Button Grid.Row="1" Text="Xóa địa chỉ"
                                            Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.DeleteAddressCommand}"
                                            CommandParameter="{Binding .}"
                                            IsEnabled="{Binding Source={x:Reference PageRoot}, Path=BindingContext.IsNotBusy}"
                                            BackgroundColor="Transparent" TextColor="{StaticResource Danger}"
                                            FontFamily="OpenSansSemibold" FontSize="12" HorizontalOptions="Start" Padding="0,4" />
                                    <Button Grid.Row="1" Grid.Column="1" Text="Chọn địa chỉ"
                                            Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.SelectAddressCommand}"
                                            CommandParameter="{Binding .}"
                                            IsEnabled="{Binding Source={x:Reference PageRoot}, Path=BindingContext.IsNotBusy}"
                                            Style="{StaticResource SecondaryButton}" FontSize="12" Padding="10,0"
                                            SemanticProperties.Description="{Binding DisplayAddress, StringFormat='Chọn địa chỉ {0}'}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" Color="{StaticResource Primary}" />
                <Label IsVisible="{Binding HasNoAddresses}" Text="Chưa có địa chỉ giao hàng. Hãy thêm địa chỉ để tiếp tục." Style="{StaticResource BodyText}" TextColor="{StaticResource TextSecondary}" />
                <Label Text="{Binding AddressMessage}" Style="{StaticResource BodyText}" TextColor="{StaticResource Danger}" />
                <Button Text="Thêm hoặc quản lý địa chỉ" Command="{Binding SetAddressCommand}" IsEnabled="{Binding IsNotBusy}" Style="{StaticResource SecondaryButton}" />
            </VerticalStackLayout>
        </Border>
    </Grid>
    <Grid Grid.RowSpan="2" IsVisible="{Binding IsVoucherPickerOpen}" BackgroundColor="#80000000" VerticalOptions="Fill" HorizontalOptions="Fill">
        <Border BackgroundColor="{StaticResource PageBackground}" StrokeThickness="0" StrokeShape="RoundRectangle 22,22,0,0" VerticalOptions="End" Padding="20,18,20,24">
            <VerticalStackLayout Spacing="14">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                        <Label Text="Chọn voucher" Style="{StaticResource SectionTitle}" />
                        <Label Text="Chạm một mã để áp dụng cho đơn hàng." Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="Đóng" Command="{Binding CloseVoucherPickerCommand}" IsEnabled="{Binding IsNotBusy}" Style="{StaticResource SecondaryButton}" FontSize="12" Padding="12,0" />
                </Grid>
                <Button Text="Tải lại voucher" Command="{Binding RefreshVouchersCommand}" IsEnabled="{Binding IsNotBusy}" Style="{StaticResource SecondaryButton}" FontSize="12" HorizontalOptions="End" Padding="12,0" />
                <CollectionView ItemsSource="{Binding EligibleVouchers}" IsVisible="{Binding HasEligibleVouchers}" SelectionMode="None" HeightRequest="300">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:VoucherDto">
                            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                                        <Label Text="{Binding IdVoucher}" Style="{StaticResource CardTitle}" />
                                        <Label Text="{Binding PhanTram, StringFormat='Giảm {0:0.##}%'}" Style="{StaticResource Caption}" />
                                        <Label Text="{Binding Promotion.NgayKt, StringFormat='Hạn dùng: {0:dd/MM/yyyy}'}" Style="{StaticResource Caption}" />
                                    </VerticalStackLayout>
                                    <Button Grid.Column="1" Text="Dùng mã"
                                            Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.SelectVoucherCommand}"
                                            CommandParameter="{Binding .}"
                                            IsEnabled="{Binding Source={x:Reference PageRoot}, Path=BindingContext.IsNotBusy}"
                                            Style="{StaticResource SecondaryButton}" FontSize="12" Padding="10,0"
                                            SemanticProperties.Description="{Binding SelectionLabel, StringFormat='Áp dụng {0}'}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" Color="{StaticResource Primary}" />
                <Label IsVisible="{Binding HasNoEligibleVouchers}" Text="Chưa có voucher phù hợp với đơn hàng này." Style="{StaticResource BodyText}" TextColor="{StaticResource TextSecondary}" />
                <Label Text="{Binding VoucherMessage}" Style="{StaticResource BodyText}" TextColor="{StaticResource Danger}" />
            </VerticalStackLayout>
        </Border>
    </Grid>
    </Grid>
</ContentPage>
