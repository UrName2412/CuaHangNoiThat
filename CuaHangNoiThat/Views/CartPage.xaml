<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CuaHangNoiThat.Models"
             xmlns:controllers="clr-namespace:CuaHangNoiThat.Controllers"
             x:Class="CuaHangNoiThat.Views.CartPage"
             x:DataType="controllers:CartController"
             x:Name="PageRoot"
             Title="Giỏ hàng"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}">
    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16,14,16,20" Spacing="16">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="MOKHA LIVING" Style="{StaticResource Eyebrow}"/>
                        <Label Text="{Binding Items.Count, StringFormat='Giỏ hàng của bạn ({0})'}" FontSize="23" FontFamily="OpenSansSemibold"/>
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text="🛍" FontSize="24" VerticalTextAlignment="Center"/>
                </Grid>
                <Border BackgroundColor="#FFF5DC" Stroke="#E8C778" StrokeShape="RoundRectangle 12" Padding="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Text="✦" TextColor="{StaticResource Accent}" FontSize="18"/>
                        <Label Grid.Column="1" Text="Đơn từ 500.000 đ được miễn phí giao &amp; lắp đặt." TextColor="#8A5E20" FontSize="11" VerticalTextAlignment="Center"/>
                    </Grid>
                </Border>
                <CollectionView ItemsSource="{Binding Items}" IsVisible="{Binding HasItems}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:CartItemModel">
                            <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,10">
                                <Grid ColumnDefinitions="72,*,Auto" ColumnSpacing="10">
                                    <Border HeightRequest="84" BackgroundColor="{StaticResource Secondary}" StrokeThickness="0" StrokeShape="RoundRectangle 12" VerticalOptions="Center">
                                        <Grid>
                                            <Label Text="▧" FontSize="36" TextColor="{StaticResource Primary}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                                            <Image Source="{Binding ImageName}" Aspect="AspectFill"/>
                                        </Grid>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                        <Label Text="{Binding ProductName}" FontSize="13" FontFamily="OpenSansSemibold" MaxLines="2"/>
                                        <Label Text="{Binding UnitPriceFormatted}" FontSize="12" TextColor="{StaticResource Primary}"/>
                                        <Label Text="{Binding TotalPriceFormatted}" FontSize="11" TextColor="{StaticResource TextSecondary}"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2" Spacing="5" VerticalOptions="Center">
                                        <HorizontalStackLayout Spacing="0">
                                            <Button Text="−" Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.DecreaseQuantityCommand}" CommandParameter="{Binding}" BackgroundColor="{StaticResource SurfaceMuted}" TextColor="{StaticResource TextPrimary}" CornerRadius="7" WidthRequest="40" HeightRequest="40" Padding="0"/>
                                            <Label Text="{Binding Quantity}" WidthRequest="28" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" FontFamily="OpenSansSemibold"/>
                                            <Button Text="+" Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.IncreaseQuantityCommand}" CommandParameter="{Binding}" BackgroundColor="{StaticResource SurfaceMuted}" TextColor="{StaticResource TextPrimary}" CornerRadius="7" WidthRequest="40" HeightRequest="40" Padding="0"/>
                                        </HorizontalStackLayout>
                                        <Button Text="Xóa" Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.RemoveCartItemCommand}" CommandParameter="{Binding}" BackgroundColor="Transparent" TextColor="{StaticResource Primary}" FontSize="10" HeightRequest="40" Padding="0"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <VerticalStackLayout IsVisible="{Binding IsEmpty}" HorizontalOptions="Center" Spacing="8" Padding="20,28,20,20">
                    <Label Text="Giỏ hàng đang trống" Style="{StaticResource SectionTitle}" FontSize="19" HorizontalTextAlignment="Center"/>
                    <Label Text="Thêm một thiết kế bạn yêu thích để bắt đầu." Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center"/>
                    <Button Text="KHÁM PHÁ SẢN PHẨM" Command="{Binding GoToCatalogCommand}" Style="{StaticResource PrimaryButton}" FontSize="11" Margin="0,6,0,0"/>
                </VerticalStackLayout>
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Tạm tính" Style="{StaticResource SectionTitle}" FontSize="16"/>
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                            <Label Text="Tiền hàng" Style="{StaticResource MutedLabel}"/>
                            <Label Grid.Column="1" Text="{Binding Subtotal}" FontSize="12"/>
                            <Label Grid.Row="1" Text="Giao &amp; lắp đặt" Style="{StaticResource MutedLabel}"/>
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding ShippingFee}" FontSize="12"/>
                            <BoxView Grid.Row="2" Grid.ColumnSpan="2" HeightRequest="1" Color="#E9E1D9"/>
                            <Label Grid.Row="2" Text="Tổng thanh toán" FontFamily="OpenSansSemibold"/>
                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding Total}" TextColor="{StaticResource Primary}" FontSize="16" FontFamily="OpenSansSemibold"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
        <Border Grid.Row="1" BackgroundColor="{StaticResource Surface}" StrokeThickness="0" Padding="16,10">
            <Button Text="TIẾN HÀNH THANH TOÁN  →" Command="{Binding CheckoutCommand}" IsEnabled="{Binding HasItems}" Style="{StaticResource PrimaryButton}" HeightRequest="52"/>
        </Border>
    </Grid>
</ContentPage>
