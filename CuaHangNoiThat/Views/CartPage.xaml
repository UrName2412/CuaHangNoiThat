<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CuaHangNoiThat.Models"
             xmlns:controllers="clr-namespace:CuaHangNoiThat.Controllers"
             xmlns:controls="clr-namespace:CuaHangNoiThat.Controls"
             x:Class="CuaHangNoiThat.Views.CartPage"
             x:DataType="controllers:CartController"
             x:Name="PageRoot"
             Title="Giỏ hàng"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}">
    <Grid RowDefinitions="*,Auto">
    <CollectionView ItemsSource="{Binding Items}" SelectionMode="None">
        <CollectionView.Header>
                <VerticalStackLayout Padding="20,18,20,18" Spacing="4">
                    <Label Text="MOKHA LIVING" Style="{StaticResource Eyebrow}" />
                    <Label Text="{Binding Items.Count, StringFormat='Giỏ hàng ({0})'}" Style="{StaticResource PageTitle}" />
                </VerticalStackLayout>
        </CollectionView.Header>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:CartItemModel">
                            <Border Style="{StaticResource Card}" Padding="12" Margin="20,0,20,10">
                                <Grid ColumnDefinitions="Auto,84,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                    <controls:AppCheckBox IsChecked="{Binding IsSelected}" VerticalOptions="Start" AccessibleName="{Binding ProductName, StringFormat='Chọn {0} để mua'}" />
                                    <Border Grid.Column="1" HeightRequest="96"
                                            BackgroundColor="{StaticResource Secondary}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 12"
                                            VerticalOptions="Start">
                                        <controls:ProductImageView Url="{Binding ImageName}" AccessibleName="{Binding ProductName}" AutoSize="False" HeightRequest="96" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="2" Spacing="6">
                                        <Label Text="{Binding ProductName}" Style="{StaticResource CardTitle}" MaxLines="2" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding UnitPriceFormatted}" Style="{StaticResource Caption}" />
                                        <Label Text="{Binding TotalPriceFormatted}" FontFamily="OpenSansSemibold" FontSize="15" TextColor="{StaticResource Primary}" />
                                    </VerticalStackLayout>
                                        <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="6">
                                            <Button Text="−" Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.DecreaseQuantityCommand}" CommandParameter="{Binding .}" BackgroundColor="{StaticResource SurfaceMuted}" TextColor="{StaticResource TextPrimary}" CornerRadius="10" WidthRequest="44" HeightRequest="44" Padding="0" FontSize="18" SemanticProperties.Description="Giảm số lượng" />
                                            <Label Grid.Column="1" Text="{Binding Quantity}" MinimumWidthRequest="28" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" FontFamily="OpenSansSemibold" />
                                            <Button Grid.Column="2" Text="+" Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.IncreaseQuantityCommand}" CommandParameter="{Binding .}" IsEnabled="{Binding CanIncreaseQuantity}" BackgroundColor="{StaticResource SurfaceMuted}" TextColor="{StaticResource TextPrimary}" CornerRadius="10" WidthRequest="44" HeightRequest="44" Padding="0" FontSize="18" SemanticProperties.Description="Tăng số lượng" />
                                            <Button Grid.Column="4" Text="Xóa" Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.RemoveCartItemCommand}" CommandParameter="{Binding .}" BackgroundColor="Transparent" TextColor="{StaticResource Danger}" FontFamily="OpenSansSemibold" FontSize="12" HeightRequest="44" Padding="8,0" />
                                        </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
        <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" Spacing="10" Padding="20,36,20,28">
                    <Label Text="Giỏ hàng đang trống" Style="{StaticResource SectionTitle}" HorizontalTextAlignment="Center" />
                    <Label Text="Sản phẩm bạn thêm sẽ xuất hiện tại đây." Style="{StaticResource BodyText}" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
                    <Button Text="KHÁM PHÁ SẢN PHẨM" Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.GoToCatalogCommand}" Style="{StaticResource PrimaryButton}" Margin="0,6,0,0" />
                </VerticalStackLayout>
        </CollectionView.EmptyView>
        <CollectionView.Footer>
                <Border IsVisible="{Binding HasItems}" Style="{StaticResource Card}" Padding="16" Margin="20,8,20,24">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Tóm tắt đơn hàng" Style="{StaticResource SectionTitle}" />
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                            <Label Text="Tiền hàng" Style="{StaticResource BodyText}" TextColor="{StaticResource TextSecondary}" />
                            <Label Grid.Column="1" Text="{Binding Subtotal}" Style="{StaticResource BodyText}" />
                            <Label Grid.Row="1" Text="Giao hàng" Style="{StaticResource BodyText}" TextColor="{StaticResource TextSecondary}" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding ShippingFee}" Style="{StaticResource BodyText}" />
                            <BoxView Grid.Row="2" Grid.ColumnSpan="2" HeightRequest="1" Color="{StaticResource BorderSubtle}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Tổng thanh toán" FontFamily="OpenSansSemibold" FontSize="15" />
                            <Label Grid.Column="1" Text="{Binding Total}" FontFamily="OpenSansSemibold" FontSize="17" TextColor="{StaticResource Primary}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
        </CollectionView.Footer>
    </CollectionView>
    <Border Grid.Row="1" BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource BorderSubtle}" Padding="12">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
            <HorizontalStackLayout Spacing="0">
                <controls:AppCheckBox IsChecked="{Binding IsAllSelected}" AccessibleName="Chọn tất cả sản phẩm" />
                <Label Text="Tất cả" VerticalOptions="Center" FontSize="12" />
            </HorizontalStackLayout>
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" HorizontalOptions="End">
                <Label Text="Tổng cộng" Style="{StaticResource Caption}" />
                <Label Text="{Binding Total}" TextColor="{StaticResource Primary}" FontFamily="OpenSansSemibold" HorizontalTextAlignment="End" />
            </VerticalStackLayout>
            <Button Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding CheckoutLabel}" Command="{Binding CheckoutCommand}" IsEnabled="{Binding HasSelectedItems}" Style="{StaticResource PrimaryButton}" Padding="14,0" MinimumHeightRequest="48" />
        </Grid>
    </Border>
    <Grid Grid.RowSpan="2" IsVisible="{Binding IsRemoveConfirmationOpen}" BackgroundColor="#80000000">
        <Border BackgroundColor="{StaticResource Surface}" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="22" Margin="24" VerticalOptions="Center">
            <VerticalStackLayout Spacing="14">
                <Label Text="Xóa sản phẩm?" Style="{StaticResource SectionTitle}" />
                <Label Text="{Binding PendingRemovalName, StringFormat='Xóa {0} khỏi giỏ hàng?'}" Style="{StaticResource BodyText}" TextColor="{StaticResource TextSecondary}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Text="Giữ lại" Command="{Binding CancelRemoveCommand}" Style="{StaticResource SecondaryButton}" />
                    <Button Grid.Column="1" Text="Xóa" Command="{Binding ConfirmRemoveCommand}" BackgroundColor="{StaticResource Danger}" TextColor="{StaticResource White}" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
    </Grid>
</ContentPage>
