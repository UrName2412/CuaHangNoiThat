<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CuaHangNoiThat.Models"
             xmlns:controllers="clr-namespace:CuaHangNoiThat.Controllers"
             xmlns:controls="clr-namespace:CuaHangNoiThat.Controls"
             x:Class="CuaHangNoiThat.Views.HomePage" x:Name="PageRoot"
             x:DataType="controllers:HomeController" Title="Trang chủ"
             Shell.NavBarIsVisible="False" SafeAreaEdges="Container" BackgroundColor="{StaticResource PageBackground}">
    <CollectionView ItemsSource="{Binding PreviewItems}" SelectionMode="None" Margin="16,0"
                    VerticalScrollBarVisibility="Never">
        <CollectionView.ItemsLayout>
            <GridItemsLayout Orientation="Vertical" HorizontalItemSpacing="12" VerticalItemSpacing="14">
                <GridItemsLayout.Span><OnIdiom x:TypeArguments="x:Int32" Phone="2" Tablet="3" Desktop="4" Default="2" /></GridItemsLayout.Span>
            </GridItemsLayout>
        </CollectionView.ItemsLayout>
        <CollectionView.Header>
            <VerticalStackLayout Spacing="22" Padding="0,18,0,14">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <HorizontalStackLayout Spacing="7" VerticalOptions="Center">
                        <Label Text="MOKHA" FontFamily="OpenSansSemibold" FontSize="25" CharacterSpacing="1" TextColor="{StaticResource TextPrimary}" />
                        <Label Text="Living" FontSize="13" TextColor="{StaticResource Primary}" VerticalTextAlignment="End" Margin="0,0,0,4" />
                    </HorizontalStackLayout>
                    <Button Grid.Column="1" Text="⌖  Địa chỉ" Command="{Binding OpenAddressesCommand}"
                            Style="{StaticResource SecondaryButton}" CornerRadius="22" FontSize="12" Padding="12,0" />
                </Grid>

                <Border x:Name="SearchSurface" BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource BorderSubtle}" StrokeShape="RoundRectangle 16" Padding="12,0">
                    <Grid ColumnDefinitions="28,*" ColumnSpacing="8">
                        <Label Text="⌕" FontSize="27" TextColor="{StaticResource Primary}" VerticalTextAlignment="Center" AutomationProperties.IsInAccessibleTree="False" />
                        <Entry Grid.Column="1" Text="{Binding SearchText}" Placeholder="Tìm sản phẩm cho ngôi nhà..."
                               PlaceholderColor="{StaticResource TextSecondary}" TextColor="{StaticResource TextPrimary}"
                               FontSize="14" MinimumHeightRequest="50" BackgroundColor="Transparent"
                               ClearButtonVisibility="WhileEditing" ReturnType="Search" Completed="OnSearchCompleted" HandlerChanged="OnSearchHandlerChanged"
                               Focused="OnSearchFocused" Unfocused="OnSearchUnfocused" SemanticProperties.Description="Tìm kiếm sản phẩm" />
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="4,*" ColumnSpacing="14" Padding="0,3,0,0">
                    <BoxView Color="{StaticResource Accent}" VerticalOptions="Fill" />
                    <VerticalStackLayout Grid.Column="1" Spacing="8">
                        <Label Text="CẢM HỨNG CHO TỔ ẤM" Style="{StaticResource Eyebrow}" FontSize="10" CharacterSpacing="1.4" />
                        <Label Text="Không gian sống&#10;của bạn." Style="{StaticResource PageTitle}" FontSize="30" LineHeight="1.05" />
                        <Label Text="Khám phá những thiết kế nội thất phù hợp với ngôi nhà." Style="{StaticResource BodyText}" TextColor="{StaticResource TextSecondary}" LineHeight="1.25" />
                    </VerticalStackLayout>
                </Grid>

                <VerticalStackLayout Spacing="12">
                    <VerticalStackLayout.Triggers>
                        <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding Categories.Count}" Value="0"><Setter Property="IsVisible" Value="False" /></DataTrigger>
                    </VerticalStackLayout.Triggers>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Text="Khám phá phong cách" Style="{StaticResource SectionTitle}" FontSize="18" VerticalTextAlignment="Center" />
                        <Button Grid.Column="1" Text="Tất cả ↗" Command="{Binding OpenCatalogCommand}" BackgroundColor="Transparent" TextColor="{StaticResource Primary}" FontSize="12" Padding="6,0" />
                    </Grid>
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Categories}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border WidthRequest="150" MinimumHeightRequest="94" Stroke="{StaticResource BorderSubtle}" BackgroundColor="{StaticResource Secondary}" StrokeShape="RoundRectangle 18" Padding="13">
                                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="10">
                                            <Label Text="KHÁM PHÁ" FontSize="9" CharacterSpacing="1" FontFamily="OpenSansSemibold" TextColor="{StaticResource SecondaryDarkText}" AutomationProperties.IsInAccessibleTree="False" />
                                            <Label Grid.Column="1" Text="↗" FontSize="19" TextColor="{StaticResource Primary}" AutomationProperties.IsInAccessibleTree="False" />
                                            <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding .}" FontSize="16" FontFamily="OpenSansSemibold" TextColor="{StaticResource TextPrimary}" MaxLines="2" LineBreakMode="WordWrap" />
                                            <Button Grid.RowSpan="2" Grid.ColumnSpan="2" BackgroundColor="Transparent" BorderWidth="0" Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.OpenCategoryCommand}" CommandParameter="{Binding .}" SemanticProperties.Description="{Binding .}" SemanticProperties.Hint="Khám phá sản phẩm theo phong cách" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Sản phẩm" Style="{StaticResource SectionTitle}" FontSize="23" />
                        <Label Text="{Binding PreviewItems.Count, StringFormat='{0} sản phẩm để khám phá'}" Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="Xem tất cả ↗" Command="{Binding OpenCatalogCommand}" BackgroundColor="Transparent" TextColor="{StaticResource Primary}" FontSize="12" Padding="4,0" />
                </Grid>
                <HorizontalStackLayout IsVisible="{Binding IsBusy}" Spacing="8">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource Primary}" WidthRequest="20" HeightRequest="20" />
                    <Label Text="Đang tìm cảm hứng cho bạn..." Style="{StaticResource Caption}" VerticalTextAlignment="Center" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </CollectionView.Header>

        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:FurnitureItem">
                <Border BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource BorderSubtle}" StrokeShape="RoundRectangle 20" Padding="0" VerticalOptions="Fill">
                    <Border.Shadow><Shadow Brush="{StaticResource Tertiary}" Opacity="0.06" Radius="8" Offset="0,3" /></Border.Shadow>
                    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="0" VerticalOptions="Fill">
                        <Border Margin="8" StrokeThickness="0" StrokeShape="RoundRectangle 14">
                            <controls:ProductImageView Url="{Binding ImageName}" AccessibleName="{Binding Name}" />
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.OpenDetailsCommand}" CommandParameter="{Binding .}" /></Border.GestureRecognizers>
                        </Border>
                        <Grid Grid.Row="1" Padding="12,2,12,0" RowDefinitions="18,46,24,20,18" RowSpacing="4" VerticalOptions="Start">
                            <Label Text="{Binding Category}" Style="{StaticResource Caption}" MaxLines="1" LineBreakMode="TailTruncation" VerticalTextAlignment="Center" />
                            <Label Grid.Row="1" Text="{Binding Name}" Style="{StaticResource CardTitle}" MaxLines="2" LineBreakMode="TailTruncation" VerticalTextAlignment="Start" />
                            <Label Grid.Row="2" Text="{Binding PriceFormatted}" FontFamily="OpenSansSemibold" FontSize="16" TextColor="{StaticResource Primary}" MaxLines="1" LineBreakMode="TailTruncation" VerticalTextAlignment="Center" />
                            <FlexLayout Grid.Row="3" IsVisible="{Binding HasDiscount}" Direction="Row" Wrap="NoWrap" AlignItems="Center">
                                <Label Text="{Binding OriginalPriceFormatted}" FontSize="11" TextColor="{StaticResource TextSecondary}" TextDecorations="Strikethrough" Margin="0,0,8,0" />
                                <Label Text="{Binding DiscountFormatted}" FontSize="11" TextColor="{StaticResource Primary}" FontFamily="OpenSansSemibold" />
                            </FlexLayout>
                            <Label Grid.Row="4" Text="{Binding StockAvailable, StringFormat='Còn {0} sản phẩm'}" Style="{StaticResource Caption}" MaxLines="1" VerticalTextAlignment="Center" />
                        </Grid>
                        <Button Grid.Row="2" Text="Chi tiết ↗" Style="{StaticResource SecondaryButton}" BackgroundColor="{StaticResource SurfaceMuted}" FontSize="12" Padding="4,0" Margin="12,4,12,12"
                                Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.OpenDetailsCommand}" CommandParameter="{Binding .}" SemanticProperties.Description="{Binding Name, StringFormat='Xem chi tiết {0}'}" />
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>

        <CollectionView.EmptyView>
            <VerticalStackLayout Padding="8,16" Spacing="12">
                <Border IsVisible="{Binding Source={x:Reference PageRoot}, Path=BindingContext.ShowEmptyState}" Style="{StaticResource Card}" Padding="20">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Chưa có sản phẩm" Style="{StaticResource SectionTitle}" HorizontalTextAlignment="Center" />
                        <Label Text="Sản phẩm sẽ xuất hiện khi có dữ liệu." Style="{StaticResource BodyText}" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border IsVisible="{Binding Source={x:Reference PageRoot}, Path=BindingContext.HasError}" Style="{StaticResource Card}" Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Không thể tải trang chủ" Style="{StaticResource SectionTitle}" />
                        <Label Text="{Binding Source={x:Reference PageRoot}, Path=BindingContext.ErrorMessage}" Style="{StaticResource Caption}" TextColor="{StaticResource Danger}" />
                        <Button Text="Thử lại" Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.RefreshCommand}" Style="{StaticResource SecondaryButton}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </CollectionView.EmptyView>
        <CollectionView.Footer>
            <VerticalStackLayout Padding="0,20,0,28">
                <Button Text="Khám phá tất cả sản phẩm  →" Command="{Binding OpenCatalogCommand}" Style="{StaticResource PrimaryButton}" HeightRequest="50" />
            </VerticalStackLayout>
        </CollectionView.Footer>
    </CollectionView>
</ContentPage>
