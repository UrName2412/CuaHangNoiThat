<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controllers="clr-namespace:CuaHangNoiThat.Controllers"
             x:Class="CuaHangNoiThat.Views.AccountPage"
             x:DataType="controllers:AccountController"
             Title="Tài khoản"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}">
    <ScrollView>
        <VerticalStackLayout Padding="20,20,20,32" Spacing="20">
            <VerticalStackLayout Spacing="4">
                <Label Text="MOKHA LIVING" Style="{StaticResource Eyebrow}" />
                <Label Text="Tài khoản" Style="{StaticResource PageTitle}" />
                <Label Text="Quản lý thông tin và đơn hàng của bạn." Style="{StaticResource BodyText}" TextColor="{StaticResource TextSecondary}" />
            </VerticalStackLayout>

            <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" Color="{StaticResource Primary}" />

            <Border IsVisible="{Binding IsSignedIn}" Style="{StaticResource Card}" Padding="16">
                <Grid ColumnDefinitions="60,*" ColumnSpacing="14">
                    <Border WidthRequest="56" HeightRequest="56" BackgroundColor="{StaticResource Secondary}" StrokeThickness="0" StrokeShape="Ellipse" VerticalOptions="Center">
                        <Label Text="♙" TextColor="{StaticResource Primary}" FontSize="26" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" SemanticProperties.Description="Ảnh đại diện tài khoản" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                        <Label Text="{Binding User.FullName}" Style="{StaticResource CardTitle}" FontSize="18" MaxLines="2" />
                        <Label Text="{Binding User.Email}" Style="{StaticResource Caption}" MaxLines="1" />
                        <HorizontalStackLayout Spacing="6" Margin="0,2,0,0">
                            <Ellipse WidthRequest="8" HeightRequest="8" Fill="{StaticResource Success}" VerticalOptions="Center" />
                            <Label Text="Đang đăng nhập" Style="{StaticResource Caption}" TextColor="{StaticResource Success}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <VerticalStackLayout IsVisible="{Binding IsSignedIn}" Spacing="9">
                <Label Text="MUA SẮM" Style="{StaticResource Eyebrow}" Margin="2,0" />
                <Border Style="{StaticResource Card}" Padding="14,4">
                    <VerticalStackLayout Spacing="0">
                        <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="10" HeightRequest="52">
                            <Border BackgroundColor="{StaticResource SurfaceMuted}" StrokeThickness="0" StrokeShape="RoundRectangle 11" WidthRequest="36" HeightRequest="36" VerticalOptions="Center"><Label Text="▤" TextColor="{StaticResource Primary}" FontSize="18" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" /></Border>
                            <Label Grid.Column="1" Text="Đơn hàng" Style="{StaticResource BodyText}" VerticalTextAlignment="Center" />
                            <Label Grid.Column="2" Text="›" TextColor="{StaticResource TextSecondary}" FontSize="25" VerticalTextAlignment="Center" />
                            <Button Grid.ColumnSpan="3" Command="{Binding OpenOrdersCommand}" BackgroundColor="Transparent" BorderWidth="0" SemanticProperties.Description="Đơn hàng" SemanticProperties.Hint="Mở lịch sử đơn hàng" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource BorderSubtle}" Margin="46,0,0,0" />
                        <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="10" HeightRequest="52">
                            <Border BackgroundColor="{StaticResource SurfaceMuted}" StrokeThickness="0" StrokeShape="RoundRectangle 11" WidthRequest="36" HeightRequest="36" VerticalOptions="Center"><Label Text="▱" TextColor="{StaticResource Primary}" FontSize="19" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" /></Border>
                            <Label Grid.Column="1" Text="Giỏ hàng" Style="{StaticResource BodyText}" VerticalTextAlignment="Center" />
                            <Label Grid.Column="2" Text="›" TextColor="{StaticResource TextSecondary}" FontSize="25" VerticalTextAlignment="Center" />
                            <Button Grid.ColumnSpan="3" Command="{Binding OpenCartCommand}" BackgroundColor="Transparent" BorderWidth="0" SemanticProperties.Description="Giỏ hàng" SemanticProperties.Hint="Mở giỏ hàng" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout IsVisible="{Binding IsSignedIn}" Spacing="9">
                <Label Text="THÔNG TIN CÁ NHÂN" Style="{StaticResource Eyebrow}" Margin="2,0" />
                <Border Style="{StaticResource Card}" Padding="14,4">
                    <VerticalStackLayout Spacing="0">
                        <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="10" HeightRequest="52">
                            <Border BackgroundColor="{StaticResource SurfaceMuted}" StrokeThickness="0" StrokeShape="RoundRectangle 11" WidthRequest="36" HeightRequest="36" VerticalOptions="Center"><Label Text="♙" TextColor="{StaticResource Primary}" FontSize="19" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" /></Border>
                            <Label Grid.Column="1" Text="Thông tin cá nhân" Style="{StaticResource BodyText}" VerticalTextAlignment="Center" />
                            <Label Grid.Column="2" Text="›" TextColor="{StaticResource TextSecondary}" FontSize="25" VerticalTextAlignment="Center" />
                            <Button Grid.ColumnSpan="3" Command="{Binding OpenProfileCommand}" BackgroundColor="Transparent" BorderWidth="0" SemanticProperties.Description="Thông tin cá nhân" SemanticProperties.Hint="Mở và chỉnh sửa hồ sơ" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource BorderSubtle}" Margin="46,0,0,0" />
                        <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="10" HeightRequest="52">
                            <Border BackgroundColor="{StaticResource SurfaceMuted}" StrokeThickness="0" StrokeShape="RoundRectangle 11" WidthRequest="36" HeightRequest="36" VerticalOptions="Center"><Label Text="⌖" TextColor="{StaticResource Primary}" FontSize="20" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" /></Border>
                            <Label Grid.Column="1" Text="Địa chỉ giao hàng" Style="{StaticResource BodyText}" VerticalTextAlignment="Center" />
                            <Label Grid.Column="2" Text="›" TextColor="{StaticResource TextSecondary}" FontSize="25" VerticalTextAlignment="Center" />
                            <Button Grid.ColumnSpan="3" Command="{Binding OpenAddressesCommand}" BackgroundColor="Transparent" BorderWidth="0" SemanticProperties.Description="Địa chỉ giao hàng" SemanticProperties.Hint="Quản lý địa chỉ giao hàng" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <Button IsVisible="{Binding IsSignedIn}" Text="Đăng xuất" Command="{Binding LogoutCommand}" BackgroundColor="{StaticResource Surface}" TextColor="{StaticResource Danger}" BorderColor="{StaticResource BorderSubtle}" BorderWidth="1" CornerRadius="12" HeightRequest="50" FontFamily="OpenSansSemibold" />

            <VerticalStackLayout IsVisible="{Binding IsSignedOut}" Spacing="6">
                <Label Text="Chào mừng trở lại!" Style="{StaticResource SectionTitle}" FontSize="24">
                    <Label.Triggers><DataTrigger TargetType="Label" Binding="{Binding IsRegisterMode}" Value="True"><Setter Property="Text" Value="Tạo tài khoản mới" /></DataTrigger></Label.Triggers>
                </Label>
                <Label Text="Đăng nhập để theo dõi đơn hàng và thông tin mua sắm." Style="{StaticResource BodyText}" TextColor="{StaticResource TextSecondary}">
                    <Label.Triggers><DataTrigger TargetType="Label" Binding="{Binding IsRegisterMode}" Value="True"><Setter Property="Text" Value="Tạo tài khoản để quản lý đơn hàng và thanh toán thuận tiện." /></DataTrigger></Label.Triggers>
                </Label>
            </VerticalStackLayout>

            <Border IsVisible="{Binding IsSignedOut}" Style="{StaticResource Card}" Padding="16">
                <VerticalStackLayout x:Name="AuthFormContent" Spacing="14">
                    <Border BackgroundColor="{StaticResource SurfaceMuted}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="4">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                            <Button Text="Đăng nhập" Command="{Binding ShowLoginCommand}" BackgroundColor="Transparent" TextColor="{StaticResource TextSecondary}" CornerRadius="10" HeightRequest="44" BorderWidth="0">
                                <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsLoginMode}" Value="True"><Setter Property="BackgroundColor" Value="{StaticResource Tertiary}" /><Setter Property="TextColor" Value="{StaticResource White}" /></DataTrigger></Button.Triggers>
                            </Button>
                            <Button Grid.Column="1" Text="Đăng ký" Command="{Binding ShowRegisterCommand}" BackgroundColor="Transparent" TextColor="{StaticResource TextSecondary}" CornerRadius="10" HeightRequest="44" BorderWidth="0">
                                <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsRegisterMode}" Value="True"><Setter Property="BackgroundColor" Value="{StaticResource Tertiary}" /><Setter Property="TextColor" Value="{StaticResource White}" /></DataTrigger></Button.Triggers>
                            </Button>
                        </Grid>
                    </Border>
                    <VerticalStackLayout IsVisible="{Binding IsRegisterMode}" Spacing="5">
                        <Label Text="Họ và tên" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource FieldSurface}"><Entry Placeholder="Nhập họ và tên" Text="{Binding FullName}" ReturnType="Next" /></Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Email hoặc tên đăng nhập" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource FieldSurface}"><Entry Placeholder="Nhập email hoặc tên đăng nhập" Text="{Binding UsernameOrEmail}" Keyboard="Email" ReturnType="Next" /></Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Mật khẩu" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource FieldSurface}" Padding="12,0,4,0">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <Entry Placeholder="Nhập mật khẩu" Text="{Binding Password}" IsPassword="{Binding IsPasswordHidden}" ReturnType="Go" />
                                <Button Grid.Column="1" Text="{Binding PasswordVisibilityText}" Command="{Binding TogglePasswordVisibilityCommand}" BackgroundColor="Transparent" TextColor="{StaticResource Primary}" FontSize="12" Padding="8,0" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                    <Grid IsVisible="{Binding IsRegisterMode}">
                        <Button Text="Tạo tài khoản" Command="{Binding RegisterCommand}" IsEnabled="{Binding IsNotBusy}" Style="{StaticResource PrimaryButton}" HeightRequest="50">
                            <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsBusy}" Value="True"><Setter Property="Text" Value="Đang tạo tài khoản..." /></DataTrigger></Button.Triggers>
                        </Button>
                        <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" Color="{StaticResource White}" HorizontalOptions="End" VerticalOptions="Center" Margin="0,0,16,0" />
                    </Grid>
                    <Grid IsVisible="{Binding IsLoginMode}">
                        <Button Text="Đăng nhập" Command="{Binding LoginCommand}" IsEnabled="{Binding IsNotBusy}" Style="{StaticResource PrimaryButton}" HeightRequest="50">
                            <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsBusy}" Value="True"><Setter Property="Text" Value="Đang đăng nhập..." /></DataTrigger></Button.Triggers>
                        </Button>
                        <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" Color="{StaticResource White}" HorizontalOptions="End" VerticalOptions="Center" Margin="0,0,16,0" />
                    </Grid>
                    <Label IsVisible="{Binding HasMessage}" Text="{Binding Message}" TextColor="{Binding MessageColor}" Style="{StaticResource BodyText}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
