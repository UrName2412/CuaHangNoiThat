<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CuaHangNoiThat.Models"
             xmlns:controllers="clr-namespace:CuaHangNoiThat.Controllers"
             xmlns:controls="clr-namespace:CuaHangNoiThat.Controls"
             x:Class="CuaHangNoiThat.Views.AddressPage"
             x:DataType="controllers:AddressController"
             x:Name="PageRoot"
             Title="Địa chỉ giao hàng"
             BackgroundColor="{StaticResource PageBackground}">
    <Grid>
    <ScrollView>
            <VerticalStackLayout Padding="20,18,20,24" Spacing="16">
                <VerticalStackLayout Spacing="4">
                    <Label Text="TÀI KHOẢN" Style="{StaticResource Eyebrow}" />
                    <Label Text="Quản lý nơi nhận đơn hàng của bạn." Style="{StaticResource BodyText}" TextColor="{StaticResource TextSecondary}" />
                </VerticalStackLayout>
                <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" Color="{StaticResource Primary}" />

                <VerticalStackLayout IsVisible="{Binding HasAddresses}" BindableLayout.ItemsSource="{Binding Addresses}" Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:AddressDto">
                            <Border Style="{StaticResource Card}" Padding="14">
                                <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                                    <VerticalStackLayout Grid.ColumnSpan="3" Spacing="5" VerticalOptions="Center">
                                        <Label IsVisible="{Binding IsDefault}" Text="ĐỊA CHỈ MẶC ĐỊNH" Style="{StaticResource Eyebrow}" FontSize="10" CharacterSpacing="0.6" />
                                        <Label Text="{Binding DisplayAddress}" Style="{StaticResource BodyText}" LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                    <Button Grid.Row="1" Grid.Column="1"
                                            IsVisible="{Binding CanSetDefault}"
                                            Text="Đặt mặc định"
                                            Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.SetDefaultCommand}"
                                            CommandParameter="{Binding .}"
                                            Style="{StaticResource SecondaryButton}"
                                            FontSize="11"
                                            HeightRequest="44"
                                            HorizontalOptions="End"
                                            Padding="8,0" />
                                    <Button Grid.Row="1" Grid.Column="2"
                                            Text="Xóa"
                                            Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.DeleteAddressCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="Transparent"
                                            TextColor="{StaticResource Danger}"
                                            FontFamily="OpenSansSemibold"
                                            FontSize="12"
                                            HeightRequest="44"
                                            HorizontalOptions="End"
                                            Padding="8,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Border IsVisible="{Binding HasNoAddresses}" Style="{StaticResource Card}" Padding="20">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Bạn chưa có địa chỉ nào" Style="{StaticResource SectionTitle}" HorizontalTextAlignment="Center" />
                        <Label Text="Thêm địa chỉ bên dưới để sử dụng khi đặt hàng." Style="{StaticResource BodyText}" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
                <Label Text="{Binding Message}" Style="{StaticResource BodyText}" TextColor="{StaticResource Primary}" HorizontalTextAlignment="Center" />
                <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Style="{StaticResource BodyText}" TextColor="{StaticResource Danger}" HorizontalTextAlignment="Center" />
                <Button Text="Tải lại danh sách địa chỉ" IsVisible="{Binding CanRetryAddresses}" Command="{Binding RetryAddressesCommand}" Style="{StaticResource SecondaryButton}" />
                <Border BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource BorderSubtle}" StrokeShape="RoundRectangle 16" Padding="16" Margin="0,4,0,0">
            <VerticalStackLayout Spacing="9">
                <Label Text="Thêm địa chỉ mới" Style="{StaticResource SectionTitle}" />
                <Label Text="Tỉnh/thành phố" Style="{StaticResource Caption}" />
                <Border Style="{StaticResource FieldSurface}" Padding="14,4">
                    <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="44">
                        <Label Text="{Binding SelectedProvinceName}" Style="{StaticResource BodyText}" VerticalTextAlignment="Center" />
                        <Label Grid.Column="1" Text="›" TextColor="{StaticResource Primary}" FontSize="24" VerticalTextAlignment="Center" />
                        <Button Grid.ColumnSpan="2" Command="{Binding OpenProvinceChoicesCommand}" IsEnabled="{Binding CanChooseProvince}"
                                BackgroundColor="Transparent" BorderWidth="0" SemanticProperties.Description="{Binding SelectedProvinceName}" />
                    </Grid>
                </Border>
                <ActivityIndicator IsVisible="{Binding IsLoadingProvinces}" IsRunning="{Binding IsLoadingProvinces}" Color="{StaticResource Primary}" />
                <Button Text="Tải lại tỉnh/thành" Command="{Binding LoadProvincesCommand}" IsVisible="{Binding CanRetryProvinces}" Style="{StaticResource SecondaryButton}" />
                <Label Text="Phường/xã" Style="{StaticResource Caption}" />
                <Border Style="{StaticResource FieldSurface}" Padding="14,4">
                    <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="44">
                        <Label Text="{Binding SelectedWardName}" Style="{StaticResource BodyText}" VerticalTextAlignment="Center" />
                        <Label Grid.Column="1" Text="›" TextColor="{StaticResource Primary}" FontSize="24" VerticalTextAlignment="Center" />
                        <Button Grid.ColumnSpan="2" Command="{Binding OpenWardChoicesCommand}" IsEnabled="{Binding CanChooseWard}"
                                BackgroundColor="Transparent" BorderWidth="0" SemanticProperties.Description="{Binding SelectedWardName}" />
                    </Grid>
                </Border>
                <ActivityIndicator IsVisible="{Binding IsLoadingWards}" IsRunning="{Binding IsLoadingWards}" Color="{StaticResource Primary}" />
                <Button Text="Tải lại phường/xã" Command="{Binding LoadWardsCommand}" IsVisible="{Binding CanRetryWards}" Style="{StaticResource SecondaryButton}" />
                <Label Text="{Binding LocationMessage}" Style="{StaticResource Caption}" TextColor="{StaticResource Danger}" />
                <Label Text="Số nhà, tên đường" Style="{StaticResource Caption}" />
                <Border Style="{StaticResource FieldSurface}">
                    <Entry Placeholder="Số nhà, tên đường" Text="{Binding Street}" ReturnType="Done" IsEnabled="{Binding IsNotBusy}" />
                </Border>
                <HorizontalStackLayout Spacing="8">
                    <controls:AppCheckBox IsChecked="{Binding MakeDefault}" AccessibleName="Đặt làm địa chỉ mặc định" />
                    <Label Text="Đặt làm địa chỉ mặc định" Style="{StaticResource BodyText}" VerticalTextAlignment="Center" />
                </HorizontalStackLayout>
                <Button Text="Lưu địa chỉ" Command="{Binding AddAddressCommand}" IsEnabled="{Binding CanSaveAddress}" Style="{StaticResource PrimaryButton}" />
            </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
    </ScrollView>
    <Grid IsVisible="{Binding IsLocationPickerOpen}" BackgroundColor="#80000000">
        <Border BackgroundColor="{StaticResource PageBackground}" StrokeThickness="0" StrokeShape="RoundRectangle 22,22,0,0" VerticalOptions="End" Padding="20,18,20,24">
            <VerticalStackLayout Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                        <Label Text="{Binding LocationPickerTitle}" Style="{StaticResource SectionTitle}" />
                        <Label Text="Chọn khu vực giao hàng" Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="Đóng" Command="{Binding CloseLocationChoicesCommand}" Style="{StaticResource SecondaryButton}" FontSize="12" Padding="12,0" />
                </Grid>
                <CollectionView ItemsSource="{Binding LocationChoices}" SelectionMode="None" HeightRequest="340">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="controllers:LocationChoice">
                            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,8">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Secondary}" />
                                        <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="42">
                                    <Label Text="{Binding Label}" Style="{StaticResource BodyText}" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="1" Text="✓" IsVisible="{Binding IsSelected}" TextColor="{StaticResource Primary}" FontSize="18" VerticalTextAlignment="Center" />
                                    <Button Grid.ColumnSpan="2" Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.SelectLocationCommand}"
                                            CommandParameter="{Binding .}" BackgroundColor="Transparent" BorderWidth="0" SemanticProperties.Description="{Binding Label}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Border>
    </Grid>
    </Grid>
</ContentPage>
