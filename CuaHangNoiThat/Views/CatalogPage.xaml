<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CuaHangNoiThat.Models"
             xmlns:controllers="clr-namespace:CuaHangNoiThat.Controllers"
             xmlns:controls="clr-namespace:CuaHangNoiThat.Controls"
             x:Class="CuaHangNoiThat.Views.CatalogPage"
             x:DataType="controllers:CatalogController"
             x:Name="PageRoot"
             Title="Sản phẩm"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="0">
        <VerticalStackLayout Grid.Row="0" Padding="20,16,20,12" Spacing="14">
            <VerticalStackLayout Spacing="4">
                <Label Text="MOKHA LIVING" Style="{StaticResource Eyebrow}" />
                <Label Text="Tìm món đồ phù hợp" Style="{StaticResource PageTitle}" />
                <Label Text="Khám phá sản phẩm cho từng góc trong ngôi nhà." Style="{StaticResource BodyText}" TextColor="{StaticResource TextSecondary}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource FieldSurface}" HeightRequest="50">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Label Text="⌕" FontSize="22" TextColor="{StaticResource TextSecondary}" VerticalTextAlignment="Center" />
                    <Entry Grid.Column="1"
                           Placeholder="Tìm sản phẩm, danh mục..."
                           PlaceholderColor="{StaticResource TextSecondary}"
                           FontSize="14"
                           HeightRequest="48"
                           ClearButtonVisibility="WhileEditing"
                           ReturnType="Search"
                           Text="{Binding SearchText}" />
                </Grid>
            </Border>
        </VerticalStackLayout>

        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Padding="20,0,20,12" Spacing="8" BindableLayout.ItemsSource="{Binding CategoryChoices}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="controllers:CatalogCategoryChoice">
                        <Button Text="{Binding Label}"
                                Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.SelectCategoryCommand}"
                                CommandParameter="{Binding Label}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="16,0"
                                FontSize="13"
                                HeightRequest="44"
                                SemanticProperties.Hint="Lọc danh sách sản phẩm theo danh mục">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                    <Setter Property="TextColor" Value="{StaticResource White}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2" Padding="20,4,20,8" ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="10">
            <Label Text="Sản phẩm" Style="{StaticResource SectionTitle}" VerticalTextAlignment="Center" />
            <Button Grid.Column="1" IsVisible="{Binding HasAnyFilters}" Text="Xóa bộ lọc" Command="{Binding ClearFiltersCommand}" BackgroundColor="Transparent" TextColor="{StaticResource Primary}" FontSize="12" Padding="8,0" />
            <Button Grid.Column="2" Text="{Binding FilterButtonText}" Command="{Binding OpenFiltersCommand}" IsEnabled="{Binding IsNotBusy}" Style="{StaticResource SecondaryButton}" FontSize="12">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding HasAdvancedFilters}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                        <Setter Property="TextColor" Value="{StaticResource White}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Label Grid.Row="1"
                   Text="{Binding Items.Count, StringFormat='{0} sản phẩm'}"
                   Style="{StaticResource Caption}"
                   VerticalTextAlignment="Center" />
            <Label Grid.Row="2" Grid.ColumnSpan="3" IsVisible="{Binding HasAdvancedFilters}" Text="{Binding FilterSummary}" Style="{StaticResource Caption}" TextColor="{StaticResource Primary}" />
            <Label Grid.Row="3" Grid.ColumnSpan="3" IsVisible="{Binding HasCartMessage}" Text="{Binding CartMessage}" Style="{StaticResource Caption}" TextColor="{StaticResource Primary}" />
        </Grid>

        <Grid Grid.Row="3" IsVisible="{Binding IsBusy}" ColumnDefinitions="Auto,*" ColumnSpacing="8" Padding="20,4,20,8">
            <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource Primary}" WidthRequest="20" HeightRequest="20" />
            <Label Grid.Column="1" Text="Đang tải sản phẩm..." Style="{StaticResource Caption}" VerticalTextAlignment="Center" />
        </Grid>

        <Grid Grid.Row="4">
            <CollectionView ItemsSource="{Binding Items}" SelectionMode="None" Margin="16,4,16,12">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" HorizontalItemSpacing="12" VerticalItemSpacing="14">
                        <GridItemsLayout.Span>
                            <OnIdiom x:TypeArguments="x:Int32" Phone="2" Tablet="3" Desktop="4" Default="2" />
                        </GridItemsLayout.Span>
                    </GridItemsLayout>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:FurnitureItem">
                        <Border Style="{StaticResource Card}" Padding="10" VerticalOptions="Fill">
                            <Grid RowDefinitions="Auto,18,42,34,24,18,*,44" RowSpacing="7" VerticalOptions="Fill">
                                <Border BackgroundColor="{StaticResource Secondary}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12">
                                    <controls:ProductImageView Url="{Binding ImageName}" AccessibleName="{Binding Name}" />
                                </Border>
                                <Label Grid.Row="1" Text="{Binding Category}" Style="{StaticResource Eyebrow}" FontSize="12" CharacterSpacing="0.5" MaxLines="1" LineBreakMode="TailTruncation" VerticalTextAlignment="Center" />
                                <Label Grid.Row="2" Text="{Binding Name}" Style="{StaticResource CardTitle}" MaxLines="2" LineBreakMode="TailTruncation" />
                                <Label Grid.Row="3" Text="{Binding Description}"
                                       Style="{StaticResource Caption}"
                                       MaxLines="2"
                                       LineBreakMode="TailTruncation" />
                                <Label Grid.Row="4" Text="{Binding PriceFormatted}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="16"
                                       TextColor="{StaticResource Primary}"
                                       MaxLines="1"
                                       LineBreakMode="TailTruncation"
                                       VerticalTextAlignment="Center" />
                                <Label Grid.Row="5" Text="{Binding StockAvailable, StringFormat='Còn {0} sản phẩm'}"
                                       Style="{StaticResource Caption}"
                                       MaxLines="1" VerticalTextAlignment="Center" />
                                <Grid Grid.Row="7" ColumnDefinitions="*,44" ColumnSpacing="8">
                                    <Button Text="Chi tiết"
                                            Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.OpenDetailsCommand}"
                                            CommandParameter="{Binding .}"
                                            Style="{StaticResource SecondaryButton}"
                                            BackgroundColor="{StaticResource Surface}"
                                            BorderColor="{StaticResource BorderSubtle}"
                                            BorderWidth="1"
                                            TextColor="{StaticResource TextPrimary}"
                                            FontSize="12"
                                            Padding="6,0"
                                            SemanticProperties.Hint="Mở thông tin chi tiết sản phẩm" />
                                    <Button Grid.Column="1"
                                            Text="+"
                                            Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.AddToCartCommand}"
                                            CommandParameter="{Binding .}"
                                            IsEnabled="{Binding IsInStock}"
                                            Style="{StaticResource PrimaryButton}"
                                            CornerRadius="12"
                                            WidthRequest="44"
                                            HeightRequest="44"
                                            Padding="0"
                                            FontSize="20"
                                            SemanticProperties.Description="{Binding Name, StringFormat='Thêm {0} vào giỏ hàng'}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <VerticalStackLayout IsVisible="{Binding Source={x:Reference PageRoot}, Path=BindingContext.ShowEmptyState}" HorizontalOptions="Center" VerticalOptions="Center" Spacing="8" Padding="28">
                        <Label Text="Chưa tìm thấy sản phẩm" Style="{StaticResource SectionTitle}" HorizontalTextAlignment="Center" />
                        <Label Text="Thử đổi từ khóa, phong cách hoặc xóa bớt điều kiện lọc." Style="{StaticResource BodyText}" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
            <Border IsVisible="{Binding HasError}"
                    VerticalOptions="End"
                    Margin="16,0,16,16"
                    Padding="12"
                    BackgroundColor="{StaticResource Surface}"
                    Stroke="{StaticResource BorderSubtle}"
                    StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding ErrorMessage}" Style="{StaticResource BodyText}" TextColor="{StaticResource Danger}" HorizontalTextAlignment="Center" />
                    <Button Text="Thử lại" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
