<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CuaHangNoiThat.Models"
             xmlns:controllers="clr-namespace:CuaHangNoiThat.Controllers"
             x:Class="CuaHangNoiThat.Views.CatalogPage"
             x:DataType="controllers:CatalogController"
             x:Name="PageRoot"
             Title="Sản phẩm"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="0">
        <VerticalStackLayout Grid.Row="0" Padding="20,16,20,12" Spacing="14">
            <VerticalStackLayout Spacing="4">
                <Label Text="MOKHA LIVING" Style="{StaticResource Eyebrow}" />
                <Label Text="Tìm món đồ phù hợp" Style="{StaticResource PageTitle}" />
                <Label Text="Khám phá sản phẩm cho từng góc trong ngôi nhà." Style="{StaticResource BodyText}" TextColor="{StaticResource TextSecondary}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource FieldSurface}" HeightRequest="50">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Label Text="⌕" FontSize="22" TextColor="{StaticResource TextSecondary}" VerticalTextAlignment="Center" />
                    <Entry Grid.Column="1"
                           Placeholder="Tìm sản phẩm, danh mục..."
                           PlaceholderColor="{StaticResource TextSecondary}"
                           FontSize="14"
                           HeightRequest="48"
                           ClearButtonVisibility="WhileEditing"
                           ReturnType="Search"
                           Text="{Binding SearchText}" />
                </Grid>
            </Border>
        </VerticalStackLayout>

        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Padding="20,0,20,12" Spacing="8" BindableLayout.ItemsSource="{Binding Categories}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Button Text="{Binding .}"
                                Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.SelectCategoryCommand}"
                                CommandParameter="{Binding .}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="16,0"
                                FontSize="13"
                                HeightRequest="44"
                                SemanticProperties.Hint="Lọc danh sách sản phẩm theo danh mục" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2" Padding="20,4,20,8" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="10">
            <Label Text="Sản phẩm" Style="{StaticResource SectionTitle}" VerticalTextAlignment="Center" />
            <Button Grid.Column="1" Text="{Binding FilterButtonText}" Command="{Binding OpenFiltersCommand}" Style="{StaticResource SecondaryButton}" FontSize="12" />
            <Label Grid.Row="1"
                   Text="{Binding Items.Count, StringFormat='{0} sản phẩm'}"
                   Style="{StaticResource Caption}"
                   VerticalTextAlignment="Center" />
            <Button Grid.Row="1" Grid.Column="1" IsVisible="{Binding HasAdvancedFilters}" Text="Xóa bộ lọc" Command="{Binding ClearFiltersCommand}" BackgroundColor="Transparent" TextColor="{StaticResource Primary}" FontSize="12" Padding="8,0" />
            <Label Grid.Row="2" Grid.ColumnSpan="2" IsVisible="{Binding HasAdvancedFilters}" Text="{Binding FilterSummary}" Style="{StaticResource Caption}" />
        </Grid>

        <Grid Grid.Row="3" IsVisible="{Binding IsBusy}" ColumnDefinitions="Auto,*" ColumnSpacing="8" Padding="20,4,20,8">
            <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource Primary}" WidthRequest="20" HeightRequest="20" />
            <Label Grid.Column="1" Text="Đang tải sản phẩm..." Style="{StaticResource Caption}" VerticalTextAlignment="Center" />
        </Grid>

        <Grid Grid.Row="4">
            <CollectionView ItemsSource="{Binding Items}" SelectionMode="None" Margin="16,4,16,12">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" HorizontalItemSpacing="12" VerticalItemSpacing="14">
                        <GridItemsLayout.Span>
                            <OnIdiom x:TypeArguments="x:Int32" Phone="2" Tablet="3" Desktop="4" Default="2" />
                        </GridItemsLayout.Span>
                    </GridItemsLayout>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:FurnitureItem">
                        <Border Style="{StaticResource Card}" Padding="10">
                            <VerticalStackLayout Spacing="7">
                                <Border HeightRequest="148"
                                        BackgroundColor="{StaticResource Secondary}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12">
                                    <Grid>
                                        <Label Text="▧"
                                               FontSize="48"
                                               TextColor="{StaticResource Primary}"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center"
                                               AutomationProperties.IsInAccessibleTree="False" />
                                        <Image Source="{Binding ImageName}" Aspect="AspectFill" SemanticProperties.Description="{Binding Name, StringFormat='Ảnh {0}'}" />
                                    </Grid>
                                </Border>
                                <Label Text="{Binding Category}" Style="{StaticResource Eyebrow}" FontSize="12" CharacterSpacing="0.5" MaxLines="1" />
                                <Label Text="{Binding Name}" Style="{StaticResource CardTitle}" MaxLines="2" LineBreakMode="TailTruncation" MinimumHeightRequest="42" />
                                <Label Text="{Binding Description}"
                                       Style="{StaticResource Caption}"
                                       MaxLines="2"
                                       LineBreakMode="TailTruncation"
                                       MinimumHeightRequest="34" />
                                <Label Text="{Binding PriceFormatted}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="16"
                                       TextColor="{StaticResource Primary}"
                                       VerticalTextAlignment="Center" />
                                <Label Text="{Binding StockAvailable, StringFormat='Còn {0} sản phẩm'}"
                                       Style="{StaticResource Caption}"
                                       MaxLines="1" />
                                <Grid ColumnDefinitions="*,44" ColumnSpacing="8" Margin="0,2,0,0">
                                    <Button Text="Chi tiết"
                                            Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.OpenDetailsCommand}"
                                            CommandParameter="{Binding .}"
                                            Style="{StaticResource SecondaryButton}"
                                            BackgroundColor="{StaticResource Surface}"
                                            BorderColor="{StaticResource BorderSubtle}"
                                            BorderWidth="1"
                                            TextColor="{StaticResource TextPrimary}"
                                            FontSize="12"
                                            Padding="6,0"
                                            SemanticProperties.Hint="Mở thông tin chi tiết sản phẩm" />
                                    <Button Grid.Column="1"
                                            Text="+"
                                            Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.AddToCartCommand}"
                                            CommandParameter="{Binding .}"
                                            IsEnabled="{Binding IsInStock}"
                                            Style="{StaticResource PrimaryButton}"
                                            CornerRadius="12"
                                            WidthRequest="44"
                                            HeightRequest="44"
                                            Padding="0"
                                            FontSize="20"
                                            SemanticProperties.Description="{Binding Name, StringFormat='Thêm {0} vào giỏ hàng'}" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <VerticalStackLayout IsVisible="{Binding Source={x:Reference PageRoot}, Path=BindingContext.ShowEmptyState}" HorizontalOptions="Center" VerticalOptions="Center" Spacing="8" Padding="28">
                        <Label Text="Chưa tìm thấy sản phẩm" Style="{StaticResource SectionTitle}" HorizontalTextAlignment="Center" />
                        <Label Text="Thử từ khóa khác hoặc chọn danh mục khác." Style="{StaticResource BodyText}" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
            <Border IsVisible="{Binding HasError}"
                    VerticalOptions="End"
                    Margin="16,0,16,16"
                    Padding="12"
                    BackgroundColor="{StaticResource Surface}"
                    Stroke="{StaticResource BorderSubtle}"
                    StrokeShape="RoundRectangle 12">
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource BodyText}" TextColor="{StaticResource Danger}" HorizontalTextAlignment="Center" />
            </Border>
        </Grid>
    </Grid>
</ContentPage>
