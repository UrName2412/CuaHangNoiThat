<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controllers="clr-namespace:CuaHangNoiThat.Controllers"
             xmlns:controls="clr-namespace:CuaHangNoiThat.Controls"
             x:Class="CuaHangNoiThat.Views.ProductDetailPage"
             x:DataType="controllers:ProductDetailController"
             Title="Chi tiết sản phẩm"
             BackgroundColor="{StaticResource PageBackground}">
    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="0">
                <Border Margin="16,16,16,0"
                        BackgroundColor="{StaticResource Secondary}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 20">
                    <controls:ProductImageView Url="{Binding Product.ImageName}" AccessibleName="{Binding Product.Name}" />
                </Border>

                <ActivityIndicator IsVisible="{Binding IsBusy}"
                                   IsRunning="{Binding IsBusy}"
                                   Color="{StaticResource Primary}"
                                   Margin="0,12" />

                <VerticalStackLayout IsVisible="{Binding HasProduct}"
                                     Padding="20,20,20,28"
                                     Spacing="14">
                    <Label Text="{Binding Product.Category}"
                           Style="{StaticResource Eyebrow}"
                           FontSize="12" />
                    <Label Text="{Binding Product.Name}"
                           Style="{StaticResource PageTitle}"
                           MaxLines="4" />

                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding Product.PriceFormatted}"
                               FontFamily="OpenSansSemibold"
                               FontSize="24"
                               TextColor="{StaticResource Primary}" />
                        <HorizontalStackLayout Spacing="8" IsVisible="{Binding Product.HasDiscount}">
                            <Label Text="{Binding Product.OriginalPriceFormatted}"
                                   Style="{StaticResource Caption}"
                                   TextDecorations="Strikethrough"
                                   VerticalTextAlignment="Center" />
                            <Label Text="{Binding Product.DiscountFormatted}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="13"
                                   TextColor="{StaticResource Primary}"
                                   VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <Border HorizontalOptions="Start"
                            Padding="12,7"
                            BackgroundColor="{StaticResource SurfaceMuted}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12">
                        <Label Text="{Binding Product.StockAvailable, StringFormat='Còn {0} sản phẩm'}"
                               Style="{StaticResource Caption}"
                               TextColor="{StaticResource TextPrimary}" />
                    </Border>

                    <BoxView HeightRequest="1" Color="{StaticResource BorderSubtle}" Margin="0,2" />
                    <Label Text="Thông tin sản phẩm" Style="{StaticResource SectionTitle}" />
                    <Label Text="{Binding Product.Description}"
                           Style="{StaticResource BodyText}"
                           TextColor="{StaticResource TextSecondary}"
                           LineHeight="1.4" />
                </VerticalStackLayout>

                <Border IsVisible="{Binding HasError}"
                        Margin="20,8,20,24"
                        Padding="14"
                        BackgroundColor="{StaticResource Surface}"
                        Stroke="{StaticResource BorderSubtle}"
                        StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding ErrorMessage}"
                           Style="{StaticResource BodyText}"
                           TextColor="{StaticResource Danger}"
                           HorizontalTextAlignment="Center" />
                    <Button Text="Thử lại" Command="{Binding RetryCommand}" IsEnabled="{Binding IsNotBusy}" Style="{StaticResource SecondaryButton}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="1"
                BackgroundColor="{StaticResource Surface}"
                StrokeThickness="0"
                Padding="16,12">
            <VerticalStackLayout Spacing="8">
            <Label Text="{Binding CartMessage}" IsVisible="{Binding HasCartMessage}" Style="{StaticResource Caption}" TextColor="{StaticResource Primary}" HorizontalTextAlignment="Center" />
            <Button Text="THÊM VÀO GIỎ HÀNG  →"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding AddToCartCommand}"
                    IsEnabled="{Binding CanAddToCart}"
                    MinimumHeightRequest="52"
                    SemanticProperties.Hint="Thêm sản phẩm này vào giỏ hàng" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
