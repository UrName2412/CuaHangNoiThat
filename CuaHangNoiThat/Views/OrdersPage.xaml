<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CuaHangNoiThat.Models"
             xmlns:controllers="clr-namespace:CuaHangNoiThat.Controllers"
             x:Class="CuaHangNoiThat.Views.OrdersPage"
             x:DataType="controllers:OrdersController"
             Title="Đơn hàng"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}">
    <Grid RowDefinitions="Auto,*" Padding="16,18,16,20">
        <Border StrokeThickness="0" StrokeShape="RoundRectangle 18" BackgroundColor="{StaticResource Tertiary}" Padding="16">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border WidthRequest="48" HeightRequest="48" StrokeThickness="0" StrokeShape="RoundRectangle 24" BackgroundColor="#5A3925"><Label Text="TD" TextColor="{StaticResource Accent}" FontFamily="OpenSansSemibold" FontSize="16" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/></Border>
                <VerticalStackLayout Grid.Column="1" Margin="12,0" VerticalOptions="Center" Spacing="3"><Label Text="Đơn hàng của bạn" TextColor="White" FontFamily="OpenSansSemibold" FontSize="15"/><Label Text="Theo dõi các đơn đã đặt" TextColor="#C8BDB5" FontSize="11"/></VerticalStackLayout>
                <Button Grid.Column="2" Text="↻" Command="{Binding RefreshCommand}" IsEnabled="{Binding IsNotBusy}" BackgroundColor="Transparent" TextColor="White" FontSize="20" Padding="4"/>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
        <CollectionView ItemsSource="{Binding Orders}" IsVisible="{Binding IsNotBusy}" SelectionMode="None" Margin="0,16,0,0">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:OrderModel">
                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout>
                                    <Label Text="{Binding Code, StringFormat='Mã hóa đơn: {0}'}" FontFamily="OpenSansSemibold" FontSize="14"/>
                                    <Label Text="{Binding Date, StringFormat='Ngày đặt: {0}'}" Style="{StaticResource MutedLabel}"/>
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="{Binding TotalAmountFormatted}" TextColor="#A34D16" FontSize="15" FontAttributes="Bold" HorizontalTextAlignment="End" VerticalOptions="Center"/>
                            </Grid>
                            
                            <Border StrokeShape="RoundRectangle 10" BackgroundColor="#F7F5F2" Padding="10" Margin="0,10,0,0">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="Chi tiết sản phẩm" Style="{StaticResource Eyebrow}"/>
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" Spacing="6">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="models:OrderItemModel">
                                                <Grid ColumnDefinitions="2.5*,Auto,1.3*,1.5*" ColumnSpacing="8">
                                                    <Label Text="{Binding ProductName}" FontSize="12" TextColor="#191817" VerticalOptions="Center" LineBreakMode="TailTruncation"/>
                                                    <Label Text="{Binding Quantity, StringFormat='×{0}'}" FontSize="12" TextColor="#737373" VerticalOptions="Center" HorizontalTextAlignment="Center"/>
                                                    <Label Text="{Binding UnitPriceFormatted}" FontSize="12" TextColor="#737373" VerticalOptions="Center" HorizontalTextAlignment="End"/>
                                                    <Label Text="{Binding TotalPriceFormatted}" FontSize="12" TextColor="#A34D16" FontAttributes="Bold" VerticalOptions="Center" HorizontalTextAlignment="End"/>
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                            
                            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                                <Label Text="Tổng cộng:" FontSize="13" FontAttributes="Bold" TextColor="#191817" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="{Binding TotalAmountFormatted}" FontSize="15" FontAttributes="Bold" TextColor="#A34D16" HorizontalTextAlignment="End" VerticalOptions="Center"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" Color="{StaticResource Primary}" VerticalOptions="Center"/>
        <VerticalStackLayout IsVisible="{Binding IsEmpty}" HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
            <Label Text="Chưa có đơn hàng" Style="{StaticResource SectionTitle}" HorizontalTextAlignment="Center"/>
            <Label Text="Các đơn hàng của bạn sẽ hiển thị tại đây." Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center"/>
        </VerticalStackLayout>
        <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Primary}" HorizontalTextAlignment="Center" VerticalOptions="End" Margin="0,0,0,16"/>
        </Grid>
    </Grid>
</ContentPage>