<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controllers="clr-namespace:CuaHangNoiThat.Controllers"
             x:Class="CuaHangNoiThat.Views.ProfilePage"
             x:DataType="controllers:ProfileController"
             Title="Thông tin cá nhân"
             BackgroundColor="{StaticResource PageBackground}">
    <ScrollView>
        <VerticalStackLayout Padding="20,18,20,32" Spacing="20">
            <VerticalStackLayout Spacing="4">
                <Label Text="TÀI KHOẢN" Style="{StaticResource Eyebrow}" />
                <Label Text="Cập nhật thông tin liên hệ của bạn." Style="{StaticResource BodyText}" TextColor="{StaticResource TextSecondary}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource Card}" Padding="16">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Thông tin liên hệ" Style="{StaticResource SectionTitle}" />
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Họ và tên" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource FieldSurface}"><Entry Text="{Binding FullName}" Placeholder="Họ và tên" ReturnType="Next" /></Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Email" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource FieldSurface}"><Entry Text="{Binding Email}" Placeholder="Email" Keyboard="Email" ReturnType="Next" /></Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Số điện thoại" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource FieldSurface}"><Entry Text="{Binding Phone}" Placeholder="Số điện thoại" Keyboard="Telephone" ReturnType="Done" /></Border>
                    </VerticalStackLayout>
                    <Label Text="Đổi email sẽ cập nhật tên đăng nhập của tài khoản." Style="{StaticResource Caption}" />
                    <Button Text="Lưu thay đổi" Command="{Binding SaveCommand}" IsEnabled="{Binding IsNotBusy}" Style="{StaticResource PrimaryButton}" HeightRequest="50" />
                    <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" Color="{StaticResource Primary}" />
                    <Label Text="{Binding Message}" Style="{StaticResource BodyText}" TextColor="{StaticResource Primary}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" Padding="16">
                <VerticalStackLayout Spacing="12">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Đổi mật khẩu" Style="{StaticResource SectionTitle}" />
                        <Label Text="Nhập mật khẩu hiện tại để xác nhận thay đổi." Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                    <Border Style="{StaticResource FieldSurface}"><Entry Text="{Binding CurrentPassword}" Placeholder="Mật khẩu hiện tại" IsPassword="True" ReturnType="Next" /></Border>
                    <Border Style="{StaticResource FieldSurface}"><Entry Text="{Binding NewPassword}" Placeholder="Mật khẩu mới" IsPassword="True" ReturnType="Next" /></Border>
                    <Border Style="{StaticResource FieldSurface}"><Entry Text="{Binding ConfirmPassword}" Placeholder="Nhập lại mật khẩu mới" IsPassword="True" ReturnType="Done" /></Border>
                    <Button Text="Cập nhật mật khẩu" Command="{Binding ChangePasswordCommand}" IsEnabled="{Binding IsNotBusy}" Style="{StaticResource SecondaryButton}" HeightRequest="48" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
